# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lxx_bible_study?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (for subscription payments)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Webhook Secret (from Dashboard > Webhooks > Signing secret)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (create products in Dashboard > Products)
# Monthly subscription: $4.99/month
STRIPE_MONTHLY_PRICE_ID="price_..."
# Annual subscription: $39.99/year (saves ~33%)
STRIPE_ANNUAL_PRICE_ID="price_..."

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Apple OAuth
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Application
NODE_ENV="development"
